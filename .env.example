# SupplyBridge — Mandatory Environment Variables Specification

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supplybridge?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/supplybridge?schema=public"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"

# Mapbox GL JS Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.your_mapbox_access_token_here"

# Authentication & Application Secrets
AUTH_SECRET="supplybridge_super_secure_auth_secret_key_2026"
JWT_SECRET="supplybridge_super_secure_jwt_secret_key_2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Razorpay Sandbox/Test Keys)
RAZORPAY_KEY_ID="rzp_test_supplybridge"
RAZORPAY_KEY_SECRET="mock_secret_key_supplybridge"

# AI Infrastructure Configuration (Server-side ONLY — NEVER prefix with NEXT_PUBLIC_)
AI_PROVIDER="DETERMINISTIC" # Options: DETERMINISTIC | OPENAI | GEMINI | ANTHROPIC
AI_API_KEY="" # Secret provider API key
AI_MODEL="supplybridge-v1"
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=10000
AI_ENABLED=true

# AI Feature Flags
AI_ASSISTANT=true
SMART_SEARCH=true
AI_RECOMMENDATIONS=true
AI_CUSTOMER_SUPPORT=true
AI_ANALYTICS=true
